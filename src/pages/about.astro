---
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'

interface TimelineItem {
  date: string
  title: string
  subtitle: string
  isLast?: boolean
}

const timeline: TimelineItem[] = [
  { date: 'Aug 2017', title: 'BITS Pilani - Goa', subtitle: 'B.E. Computer Science with a minor in Politics, Economics and Philosophy' },
  { date: 'May 2021', title: 'BrowserStack', subtitle: 'Software Engineer' },
  { date: 'Jun 2022', title: 'CERN', subtitle: 'Fullstack Engineer' },
  { date: 'Aug 2025', title: 'Career Break', subtitle: 'Taking time to recalibrate' },
  { date: 'Sep 2026', title: 'IMT Atlantique', subtitle: 'MS in Data Science', isLast: true },
]
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />

  <div class="p-4 sm:p-6">
    <p class="text-sm text-muted-foreground mb-4">I'm an engineer who's spent time building systems at places like BrowserStack and CERN, currently on a break to recalibrate before starting an MS in Data Science. I write here about the technical stuff I'm learning and the personal reflections along the way.</p>
    <h2 class="mb-6 text-lg font-medium">My Journey</h2>

    <div class="hidden sm:block">
      {
        timeline.map((item, index) => (
          <div
            class={`relative flex gap-4${item.isLast ? '' : ' pb-10'}`}
            style={`opacity:0;animation:fadeInUp 0.5s ease-out ${0.3 + index * 0.3}s forwards`}
          >
            <div class="relative hidden sm:flex flex-col items-center">
              {!item.isLast && (
                <div class="absolute left-1/2 top-6 bottom-0 w-px bg-border -translate-x-1/2" />
              )}
              <div
                class={`size-2 rounded-full shrink-0 mt-1.5 z-10${item.isLast ? ' bg-green-500 blink-pulse' : ' bg-border'}`}
              />
            </div>
            <div class="flex-1 min-w-0">
              <span class="text-xs text-muted-foreground font-medium tabular-nums">{item.date}</span>
              <p class="text-sm font-medium">{item.title}</p>
              <p class="text-xs text-muted-foreground">{item.subtitle}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="sm:hidden space-y-3">
      {
        timeline.map((item) => (
          <div class="text-sm">
            <span class="text-muted-foreground font-medium tabular-nums">{item.date}</span>
            — <span class="font-medium">{item.title}</span>
            <span class="text-muted-foreground"> · {item.subtitle}</span>
          </div>
        ))
      }
    </div>
  </div>

  <style is:inline>
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .blink-pulse { animation: pulse 1.5s ease-in-out infinite; }
  </style>
</Layout>
