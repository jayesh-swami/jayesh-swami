---
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />

  <div class="p-4 sm:p-6">
    <p class="text-sm text-muted-foreground mb-4">Hi there — here's a quick look at my journey.</p>
    <h2 class="mb-6 text-lg font-medium">My Journey</h2>

    <div class="hidden sm:block">
      <div class="relative flex gap-4 pb-10" style="opacity:0;animation:fadeInUp 0.5s ease-out 0.3s forwards">
        <div class="relative hidden sm:flex flex-col items-center">
          <div class="absolute left-1/2 top-6 bottom-0 w-px bg-border -translate-x-1/2" />
          <div class="size-2 rounded-full bg-border shrink-0 mt-1.5 z-10" />
        </div>
        <div class="flex-1 min-w-0">
          <span class="text-xs text-muted-foreground font-medium tabular-nums">Aug 2017</span>
          <p class="text-sm font-medium">BITS Pilani - Goa</p>
          <p class="text-xs text-muted-foreground">B.E. Computer Science</p>
        </div>
      </div>

      <div class="relative flex gap-4 pb-10" style="opacity:0;animation:fadeInUp 0.5s ease-out 0.6s forwards">
        <div class="relative hidden sm:flex flex-col items-center">
          <div class="absolute left-1/2 top-6 bottom-0 w-px bg-border -translate-x-1/2" />
          <div class="size-2 rounded-full bg-border shrink-0 mt-1.5 z-10" />
        </div>
        <div class="flex-1 min-w-0">
          <span class="text-xs text-muted-foreground font-medium tabular-nums">May 2021</span>
          <p class="text-sm font-medium">BrowserStack</p>
          <p class="text-xs text-muted-foreground">Software Engineer</p>
        </div>
      </div>

      <div class="relative flex gap-4 pb-10" style="opacity:0;animation:fadeInUp 0.5s ease-out 0.9s forwards">
        <div class="relative hidden sm:flex flex-col items-center">
          <div class="absolute left-1/2 top-6 bottom-0 w-px bg-border -translate-x-1/2" />
          <div class="size-2 rounded-full bg-border shrink-0 mt-1.5 z-10" />
        </div>
        <div class="flex-1 min-w-0">
          <span class="text-xs text-muted-foreground font-medium tabular-nums">Jun 2022</span>
          <p class="text-sm font-medium">CERN</p>
          <p class="text-xs text-muted-foreground">Fullstack Engineer</p>
        </div>
      </div>

      <div class="relative flex gap-4 pb-10" style="opacity:0;animation:fadeInUp 0.5s ease-out 1.2s forwards">
        <div class="relative hidden sm:flex flex-col items-center">
          <div class="absolute left-1/2 top-6 bottom-0 w-px bg-border -translate-x-1/2" />
          <div class="size-2 rounded-full bg-border shrink-0 mt-1.5 z-10" />
        </div>
        <div class="flex-1 min-w-0">
          <span class="text-xs text-muted-foreground font-medium tabular-nums">Aug 2025</span>
          <p class="text-sm font-medium">Career Break</p>
          <p class="text-xs text-muted-foreground">Taking time to recalibrate</p>
        </div>
      </div>

      <div class="relative flex gap-4" style="opacity:0;animation:fadeInUp 0.5s ease-out 1.5s forwards">
        <div class="relative hidden sm:flex flex-col items-center">
          <div class="size-2 rounded-full bg-green-500 shrink-0 mt-1.5 z-10 blink-pulse" />
        </div>
        <div class="flex-1 min-w-0">
          <span class="text-xs text-muted-foreground font-medium tabular-nums">Sep 2026</span>
          <p class="text-sm font-medium">IMT Atlantique</p>
          <p class="text-xs text-muted-foreground">MS in Data Science</p>
        </div>
      </div>
    </div>

    <div class="sm:hidden space-y-3">
      <div class="text-sm"><span class="text-muted-foreground font-medium tabular-nums">Aug 2017</span> — <span class="font-medium">BITS Pilani - Goa</span> <span class="text-muted-foreground">· B.E. Computer Science</span></div>
      <div class="text-sm"><span class="text-muted-foreground font-medium tabular-nums">May 2021</span> — <span class="font-medium">BrowserStack</span> <span class="text-muted-foreground">· Software Engineer</span></div>
      <div class="text-sm"><span class="text-muted-foreground font-medium tabular-nums">Jun 2022</span> — <span class="font-medium">CERN</span> <span class="text-muted-foreground">· Fullstack Engineer</span></div>
      <div class="text-sm"><span class="text-muted-foreground font-medium tabular-nums">Aug 2025</span> — <span class="font-medium">Career Break</span> <span class="text-muted-foreground">· Taking time to recalibrate</span></div>
      <div class="text-sm"><span class="text-muted-foreground font-medium tabular-nums">Sep 2026</span> — <span class="font-medium">IMT Atlantique</span> <span class="text-muted-foreground">· MS in Data Science</span></div>
    </div>
  </div>

  <style is:inline>
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .blink-pulse { animation: pulse 1.5s ease-in-out infinite; }
  </style>
</Layout>
