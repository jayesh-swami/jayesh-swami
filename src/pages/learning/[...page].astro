---
import LearningCard from '@/components/learning-card.astro'
import ProjectCard from '@/components/project-card.astro'
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import PaginationComponent from '@/components/ui/pagination'
import Layout from '@/layouts/layout.astro'
import LearningTabs from '@/components/learning-tabs.astro'
import { getLearningWithPosts, getLearningCounts, getLearningSortDate, LEARNING_DESCRIPTION } from '@/lib/learning-utils'
import { getCollection } from 'astro:content'
import type { LearningEntry } from '@/lib/learning-utils'
import type { CollectionEntry } from 'astro:content'

type CombinedItem =
  | { type: 'learning'; entry: LearningEntry }
  | { type: 'project'; entry: CollectionEntry<'projects'> }

type PageProps = {
  entries: CombinedItem[]
  currentPage: number
  lastPage: number
}

export async function getStaticPaths() {
  const pageSize = 5
  const [learningEntries, projects] = await Promise.all([
    getLearningWithPosts(),
    getCollection('projects'),
  ])

  const combined: CombinedItem[] = [
    ...learningEntries.map((entry) => ({ type: 'learning' as const, entry })),
    ...projects.map((entry) => ({ type: 'project' as const, entry })),
  ].sort((a, b) => {
    const dateA = a.type === 'learning'
      ? getLearningSortDate(a.entry)?.valueOf() ?? 0
      : a.entry.data.date.valueOf()
    const dateB = b.type === 'learning'
      ? getLearningSortDate(b.entry)?.valueOf() ?? 0
      : b.entry.data.date.valueOf()
    return dateB - dateA
  })

  const lastPage = Math.ceil(combined.length / pageSize) || 1
  const paths: { params: { page?: string }; props: PageProps }[] = []

  for (let i = 0; i < combined.length; i += pageSize) {
    const pageNum = Math.floor(i / pageSize) + 1
    paths.push({
      params: { page: pageNum === 1 ? undefined : String(pageNum) },
      props: {
        entries: combined.slice(i, i + pageSize),
        currentPage: pageNum,
        lastPage,
      },
    })
  }

  if (paths.length === 0) {
    paths.push({
      params: { page: undefined },
      props: { entries: [], currentPage: 1, lastPage: 1 },
    })
  }

  return paths
}

const { entries, currentPage, lastPage } = Astro.props as PageProps

const counts = await getLearningCounts()
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Learning" />
  <Breadcrumbs
    items={[
      { label: 'Learning', href: '/learning', icon: 'lucide:graduation-cap' },
    ]}
  />

  <section class="text-muted-foreground mb-6 text-sm leading-relaxed">
    <p>{LEARNING_DESCRIPTION}</p>
  </section>

  <LearningTabs activeTab="all" counts={counts} />

  <div class="flex flex-col gap-y-4">
    {entries.length === 0 && (
      <p class="text-muted-foreground py-8 text-center text-sm">No entries recorded yet.</p>
    )}
    {entries.map((item) =>
      item.type === 'learning' ? (
        <LearningCard entry={item.entry} />
      ) : (
        <ProjectCard entry={item.entry} />
      )
    )}
  </div>

  <PaginationComponent
    currentPage={currentPage}
    totalPages={lastPage}
    baseUrl="/learning/"
    client:load
  />
</Layout>
