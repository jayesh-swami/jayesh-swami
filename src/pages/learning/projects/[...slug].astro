---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import PaginationComponent from '@/components/ui/pagination'
import Layout from '@/layouts/layout.astro'
import { Badge } from '@/components/ui/badge'
import { Separator } from '@/components/ui/separator'
import { Icon } from 'astro-icon/components'
import { getCollection, render } from 'astro:content'
import { formatDate } from '@/lib/utils'
import { getLearningWithPosts, filterByType } from '@/lib/learning-utils'

export async function getStaticPaths() {
  const pageSize = 5
  const allProjects = await getCollection('projects')
  const paths: any[] = []

  for (const entry of allProjects) {
    const slug = entry.id.replace(/\.mdx$/, '')
    paths.push({
      params: { slug },
      props: { mode: 'detail', entry },
    })
  }

  const lastPage = Math.ceil(allProjects.length / pageSize) || 1
  if (allProjects.length === 0) {
    paths.push({
      params: { slug: undefined },
      props: { mode: 'list', entries: [], currentPage: 1, lastPage: 1 },
    })
  }
  for (let i = 0; i < allProjects.length; i += pageSize) {
    const pageNum = Math.floor(i / pageSize) + 1
    paths.push({
      params: { slug: pageNum === 1 ? undefined : String(pageNum) },
      props: {
        mode: 'list',
        entries: allProjects.slice(i, i + pageSize),
        currentPage: pageNum,
        lastPage,
      },
    })
  }

  return paths
}

const { mode, entry, entries, currentPage, lastPage } = Astro.props

const allEntries = await getLearningWithPosts()
const allCourses = filterByType(allEntries, 'courses')
const allPapers = filterByType(allEntries, 'paper-readings')
const allProjects = (await getCollection('projects')).length

let d: any = null
let rendered: any = null

if (mode === 'detail' && entry) {
  d = entry.data
  rendered = await render(entry)
}
---

{
  mode === 'detail' && entry ? (
    <Layout>
      <PageHead slot="head" title={d.title} description={d.description} />
      <section class="grid grid-cols-[minmax(0px,1fr)_min(calc(var(--breakpoint-md)-2rem),100%)_minmax(0px,1fr)] gap-y-6">
        <div class="col-start-2 flex flex-col gap-y-6">
          <Breadcrumbs
            items={[
              { href: '/learning', label: 'Learning', icon: 'lucide:graduation-cap' },
              { href: '/learning/projects', label: 'Projects', icon: 'lucide:folder-kanban' },
              { label: d.title, icon: 'lucide:folder-kanban' },
            ]}
          />
          <div class="flex flex-col gap-3">
            <h1 class="scroll-mt-31 text-3xl leading-tight font-medium sm:text-4xl">{d.title}</h1>
            <div class="text-muted-foreground flex flex-wrap items-center gap-x-2 text-xs sm:text-sm">
              <span>{formatDate(d.date)}</span>
            </div>
          </div>
          <div class="flex flex-wrap gap-2">
            {d.github && (
              <a
                href={d.github}
                target="_blank"
                rel="noopener noreferrer"
                class="border-muted-foreground/20 hover:bg-muted inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm transition-colors"
              >
                <Icon name="lucide:github" class="size-3.5" />
                GitHub
              </a>
            )}
            {d.website && (
              <a
                href={d.website}
                target="_blank"
                rel="noopener noreferrer"
                class="border-muted-foreground/20 hover:bg-muted inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm transition-colors"
              >
                <Icon name="lucide:external-link" class="size-3.5" />
                Website
              </a>
            )}
          </div>
          {d.labels && d.labels.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {d.labels.map((label: string) => (
                <Badge variant="muted" className="flex items-center gap-x-1">
                  <Icon name="lucide:hash" class="size-3" />
                  {label}
                </Badge>
              ))}
            </div>
          )}
          {rendered && (
            <article class="prose max-w-none">
              <rendered.Content />
            </article>
          )}
        </div>
      </section>
    </Layout>
  ) : (
    <Layout class="max-w-3xl">
      <PageHead slot="head" title="Projects — Learning" />
      <Breadcrumbs
        items={[
          { href: '/learning', label: 'Learning', icon: 'lucide:graduation-cap' },
          { href: '/learning/projects', label: 'Projects', icon: 'lucide:folder-kanban' },
        ]}
      />
      <section class="text-muted-foreground mb-6 text-sm leading-relaxed">
        <p>
          A curated collection of courses and papers I've studied, documenting my learning journey — what I studied, what I built, and what I learned along the way.
        </p>
      </section>
      <div class="mb-6 flex gap-2 border-b pb-2">
        <a href="/learning" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 px-3 py-1.5 text-sm transition-colors">
          All ({allEntries.length})
        </a>
        <a href="/learning/courses" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 px-3 py-1.5 text-sm transition-colors">
          <Icon name="lucide:book-open" class="size-4" />
          Courses ({allCourses.length})
        </a>
        <a href="/learning/projects" class="border-foreground border-b-2 font-medium inline-flex items-center gap-1.5 px-3 py-1.5 text-sm transition-colors">
          <Icon name="lucide:folder-kanban" class="size-4" />
          Projects ({allProjects})
        </a>
        <a href="/learning/papers" class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 px-3 py-1.5 text-sm transition-colors">
          <Icon name="lucide:file-text" class="size-4" />
          Papers ({allPapers.length})
        </a>
      </div>
      <div class="flex flex-col gap-y-4">
        {entries.length === 0 && (
          <p class="text-muted-foreground py-8 text-center text-sm">No projects recorded yet.</p>
        )}
        {entries.map((p: any) => {
          const projectSlug = p.id.replace(/\.mdx$/, '')
          return (
            <a
              href={`/learning/projects/${projectSlug}`}
              class="hover:bg-muted/50 rounded-xl border p-4 transition-colors duration-300 ease-in-out block"
            >
              <div class="flex flex-col gap-3">
                <h3 class="text-lg font-medium">{p.data.title}</h3>
                <div class="text-muted-foreground flex flex-wrap items-center gap-x-2 text-xs">
                  <span>Projects</span>
                  <Separator orientation="vertical" className="h-4!" />
                  <span>{formatDate(p.data.date)}</span>
                </div>
                <p class="text-muted-foreground text-sm">{p.data.description}</p>
                {p.data.labels && p.data.labels.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {p.data.labels.map((label: string) => (
                      <Badge variant="muted" className="flex items-center gap-x-1">
                        <Icon name="lucide:hash" class="size-3" />
                        {label}
                      </Badge>
                    ))}
                  </div>
                )}
              </div>
            </a>
          )
        })}
      </div>
      <PaginationComponent currentPage={currentPage} totalPages={lastPage} baseUrl="/learning/projects/" client:load />
    </Layout>
  )
}
